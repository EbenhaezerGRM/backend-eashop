generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String
  description String @default("")
  price       Int
  category    String
  stock       Int    @default(0)

  sellerId Int?
  seller   Seller? @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

enum PromoSource {
  SELLER
  PLATFORM
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum VoucherType {
  DISCOUNT
  FREE_SHIPPING
}

model Promo {
  id          Int         @id @default(autoincrement())
  name        String
  source      PromoSource
  sellerId    Int?
  seller      Seller?     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  voucherType VoucherType @default(DISCOUNT)
  stock       Int         @default(0)

  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(12, 2)
  minimumPurchase Int          @default(0)
  maximumDiscount Int?

  shippingDiscountTiers Json?

  isStackable Boolean      @default(false)
  orderUsages OrderPromo[]

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, sellerId])
  @@map("promos")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  addressId Int
  status    OrderStatus @default(PENDING)

  subtotal         Int
  productDiscount  Int    @default(0)
  shippingService  String
  shippingCost     Int
  shippingDiscount Int    @default(0)
  totalPayable     Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  items    OrderItem[]
  promos   OrderPromo[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int

  productName  String
  unitPrice    Int
  quantity     Int
  lineSubtotal Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  passwordHash String
  phone        String?
  role         UserRole @default(USER)

  cart      Cart?
  addresses Address[]
  orders    Order[]
  seller    Seller?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Seller {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  storeName   String
  description String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  products Product[]
  promos   Promo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sellers")
}

model Address {
  id            Int     @id @default(autoincrement())
  userId        Int
  recipientName String
  phone         String
  street        String
  city          String
  province      String
  district      String?
  postalCode    String?
  notes         String?
  isDefault     Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model OrderPromo {
  id Int @id @default(autoincrement())

  orderId Int
  promoId Int

  source         PromoSource
  voucherType    VoucherType
  discountAmount Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promo Promo @relation(fields: [promoId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([orderId, promoId])
  @@index([promoId])
  @@map("order_promos")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  DUMMY
}

model Payment {
  id Int @id @default(autoincrement())

  orderId Int

  provider PaymentProvider @default(DUMMY)
  status   PaymentStatus   @default(PENDING)

  amount        Int
  transactionId String @unique @default(cuid())

  paidAt        DateTime?
  failureReason String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, createdAt])
  @@map("payments")
}
